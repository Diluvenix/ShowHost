<Application x:Class="Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Client"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Fonts/Fonts.xaml"/>
                <ResourceDictionary Source="/Views/generic.xaml"/>

                <ResourceDictionary>
                    <sys:Double x:Key="FontMicro">1.2</sys:Double>
                    <sys:Double x:Key="FontXTiny">3.5</sys:Double>
                    <sys:Double x:Key="FontXSmall">10</sys:Double>
                    <sys:Double x:Key="FontSmall">12</sys:Double>
                    <sys:Double x:Key="FontNormal">15</sys:Double>
                    <sys:Double x:Key="FontBig">20</sys:Double>
                    <sys:Double x:Key="FontLarge">25</sys:Double>
                    <sys:Double x:Key="FontXLarge">36</sys:Double>
                    <sys:Double x:Key="FontHuge">48</sys:Double>

                    <CornerRadius x:Key="RadiusNormal">5</CornerRadius>
                    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>

                    <sys:Double x:Key="CardHeightNormal">70</sys:Double>

                    <Thickness x:Key="MarginNormal">3</Thickness>
                    <Thickness x:Key="MarginNormalHorizontal">3,0</Thickness>
                    <Thickness x:Key="MarginNormalVertical">0,3</Thickness>
                    <Thickness x:Key="MarginNormalVerticalNegative">0,-3</Thickness>
                    <Thickness x:Key="MarginLarge">10</Thickness>
                    <Thickness x:Key="MarginLargeVertical">0,10</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
