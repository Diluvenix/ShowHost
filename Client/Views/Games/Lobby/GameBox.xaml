<UserControl x:Class="Client.Views.Games.Lobby.GameBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Client.Views"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="800"
             Height="{DynamicResource CardHeightNormal}">
    <Border Background="#262626"
            CornerRadius="{DynamicResource RadiusNormal}"
            Margin="{DynamicResource MarginNormal}">
        <Grid Margin="{DynamicResource MarginNormal}">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center">
                <Label Content="[TYPE]"
                       FontWeight="Bold" 
                       FontSize="{DynamicResource FontBig}"
                       VerticalAlignment="Center"
                       x:Name="TypeLabel"/>
                <Label Content="[NAME]"
                       FontSize="{DynamicResource FontSmall}"
                       VerticalAlignment="Center"
                       Foreground="WhiteSmoke"
                       Opacity="0.7"
                       x:Name="NameLabel"/>
                <Label Content="0/0"
                       FontSize="{DynamicResource FontSmall}"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       x:Name="PlayerLabel"/>
                <Path VerticalAlignment="Center"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stroke="WhiteSmoke" 
                      StrokeThickness="{DynamicResource FontMicro}"
                      Height="{DynamicResource FontNormal}"
                      Width="{DynamicResource FontNormal}"
                      Stretch="Uniform" Opacity="0.7">
                    <Path.Data>
                        <GeometryGroup>
                            <PathGeometry Figures="M 17 21 v -2 a 4 4 0 0 0 -4 -4 H 5 a 4 4 0 0 0 -4 4 v 2" FillRule="Nonzero"/>
                            <EllipseGeometry RadiusX="4.0" RadiusY="4.0" Center="9.0,7.0"/>
                            <PathGeometry Figures="M 23 21 v -2 a 4 4 0 0 0 -3 -3.87" FillRule="Nonzero"/>
                            <PathGeometry Figures="M 16 3.13 a 4 4 0 0 1 0 7.75" FillRule="Nonzero"/>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource MarginLargeHorizontal}">
                <Border VerticalAlignment="Center"
                        Background="#3D6B3B"
                        CornerRadius="{DynamicResource RadiusLarge}"
                        x:Name="PreparingBorder">
                    <Label Content="Preparing"
                           FontSize="{DynamicResource FontXSmall}"
                           Foreground="#A7CCA7"/>
                </Border>
                <Border VerticalAlignment="Center"
                        Background="#AD8735"
                        CornerRadius="{DynamicResource RadiusLarge}"
                        Margin="{DynamicResource MarginNormal}"
                        x:Name="RunningBorder">
                    <Label Content="Running"
                           FontSize="{DynamicResource FontXSmall}"
                           Foreground="#fedd95"/>
                </Border>
                <Border Margin="{DynamicResource MarginNormalHorizontal}"/>
                <local:RoundButton Content="Join"
                                   FontSize="{DynamicResource FontLarge}"
                                   FontWeight="Bold"
                                   CornerRadius="{DynamicResource RadiusNormal}"
                                   Background="#3D6B3B"
                                   x:Name="JoinButton"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
