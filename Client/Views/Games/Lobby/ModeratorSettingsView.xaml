<UserControl x:Class="Client.Views.Games.Lobby.ModeratorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Client.Views"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid Margin="50,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" 
               Content="Settings"
               HorizontalAlignment="Center"
               FontWeight="Black"
               FontSize="{DynamicResource FontHuge}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      Margin="{DynamicResource MarginNormal}">
            <StackPanel Orientation="Vertical">
                <Label Content="Server"
                       FontWeight="Bold"
                       FontSize="{DynamicResource FontBig}"/>
                <StackPanel Orientation="Horizontal">
                    <local:RoundButton Content="Generate moderator key" 
                                       CornerRadius="{DynamicResource RadiusNormal}"
                                       HorizontalAlignment="Left" FontSize="{DynamicResource FontNormal}"
                                       Padding="{DynamicResource MarginNormal}"
                                       x:Name="ModkeyButton"/>
                    <local:InputBox IsReadOnly="True" Watermark="Moderator key"
                                    FontSize="{DynamicResource FontSmall}"
                                    CornerRadius="{DynamicResource RadiusNormal}"
                                    Margin="{DynamicResource MarginNormalHorizontal}"
                                    x:Name="ModkeyBox"/>
                    <local:RoundButton Content="Copy" 
                                       CornerRadius="{DynamicResource RadiusNormal}"
                                       HorizontalAlignment="Left" FontSize="{DynamicResource FontXSmall}"
                                       Padding="{DynamicResource MarginNormal}"
                                       x:Name="ModkeyCopyButton"/>
                </StackPanel>

                <Separator Margin="{DynamicResource MarginLargeVertical}"/>

                <Label Content="Players"
                       FontWeight="Bold"
                       FontSize="{DynamicResource FontBig}"/>

                <ComboBox x:Name="PlayersDropDown"
                          FontSize="{DynamicResource FontSmall}" Margin="0,5,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="{DynamicResource MarginNormalVertical}">
                    <local:RoundButton Content="Generate recovery key" 
                                       CornerRadius="{DynamicResource RadiusNormal}"
                                       HorizontalAlignment="Left" FontSize="{DynamicResource FontNormal}"
                                       Padding="{DynamicResource MarginNormal}"
                                       x:Name="RecoveryButton"/>
                    <local:RoundButton Content="Kick player" 
                                       CornerRadius="{DynamicResource RadiusNormal}"
                                       HorizontalAlignment="Left" FontSize="{DynamicResource FontNormal}"
                                       Padding="{DynamicResource MarginNormal}"
                                       Margin="{DynamicResource MarginNormalHorizontal}"
                                       x:Name="KickButton"/>
                    <local:RoundButton Content="Delete player" 
                                       CornerRadius="{DynamicResource RadiusNormal}"
                                       HorizontalAlignment="Left" FontSize="{DynamicResource FontNormal}"
                                       Padding="{DynamicResource MarginNormal}"
                                       x:Name="DeleteButton"/>
                    <local:InputBox IsReadOnly="True" Watermark="Recovery key"
                                    FontSize="{DynamicResource FontSmall}"
                                    CornerRadius="{DynamicResource RadiusNormal}"
                                    Margin="{DynamicResource MarginNormalHorizontal}"
                                    x:Name="RecoveryBox"/>
                    <local:RoundButton Content="Copy" 
                                       CornerRadius="{DynamicResource RadiusNormal}"
                                       HorizontalAlignment="Left" FontSize="{DynamicResource FontXSmall}"
                                       Padding="{DynamicResource MarginNormal}"
                                       x:Name="RecoveryCopyButton"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
