<UserControl x:Class="Client.Views.Games._57.SettingsPlayerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Client.Views"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="900"
             Height="{DynamicResource CardHeightNormal}">
    <Border Background="#262626"
            CornerRadius="{DynamicResource RadiusNormal}"
            Margin="{DynamicResource MarginNormal}">
        <Grid Margin="{DynamicResource MarginNormal}">
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Stretch" 
                        HorizontalAlignment="Left"
                        Margin="{DynamicResource MarginNormal}">
                <Border Background="Purple"
                        Width="{DynamicResource FontHuge}"
                        CornerRadius="{DynamicResource RadiusNormal}"
                        x:Name="ColorBorder"/>

                <Label Content="[USERNAME]"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       FontSize="{DynamicResource FontNormal}"
                       FontWeight="SemiBold"
                       Margin="{DynamicResource MarginLargeHorizontal}"
                       x:Name="UsernameLabel"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
