<UserControl x:Class="Client.Views.Games._57.PlayerLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Client.Views.Games._57"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <Grid Margin="50,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical"
                    Grid.Row="0"
                    HorizontalAlignment="Center">
            <Label Content="57"
                   HorizontalAlignment="Center"
                   FontWeight="Black"
                   FontSize="{StaticResource FontHuge}"/>
            <Label Content="[NAME]"
                   HorizontalAlignment="Center"
                   FontWeight="Bold" Opacity="0.7"
                   FontSize="{StaticResource FontNormal}"
                   Margin="{StaticResource MarginNormalVerticalNegative}"
                   x:Name="NameLabel"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    HorizontalAlignment="Right">
            <Label Content="0/0"
                   FontSize="{DynamicResource FontBig}"
                   VerticalAlignment="Center"
                   Opacity="0.7"
                   x:Name="PlayerCountLabel"/>
            <Path VerticalAlignment="Center"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stroke="WhiteSmoke" 
                      StrokeThickness="{DynamicResource FontMicro}"
                      Height="{DynamicResource FontBig}"
                      Width="{DynamicResource FontBig}"
                      Stretch="Uniform" Opacity="0.7">
                <Path.Data>
                    <GeometryGroup>
                        <PathGeometry Figures="M 17 21 v -2 a 4 4 0 0 0 -4 -4 H 5 a 4 4 0 0 0 -4 4 v 2" FillRule="Nonzero"/>
                        <EllipseGeometry RadiusX="4.0" RadiusY="4.0" Center="9.0,7.0"/>
                        <PathGeometry Figures="M 23 21 v -2 a 4 4 0 0 0 -3 -3.87" FillRule="Nonzero"/>
                        <PathGeometry Figures="M 16 3.13 a 4 4 0 0 1 0 7.75" FillRule="Nonzero"/>
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PlayerList"></ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
